# Frontend public configuration. These values are embedded into the Vite build.
# Do not put Stripe secret keys, webhook secrets, or service-account JSON here.

VITE_CLOUDINARY_CLOUD_NAME=
VITE_STRIPE_SERVER_URL=http://localhost:4242

# Firebase Web App configuration from Firebase Console -> Project settings -> Your apps.
# Use a different Firebase project for test/staging and production builds.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
